# Clara's server, run by clara-launcher (which switches releases and rolls back). Installed by deploy/install.sh.
#   sudo systemctl enable --now clara        journalctl -u clara -f
[Unit]
Description=Clara, a personal AI agent
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=notify
# the server is a child of the launcher: it sends READY=1 and WATCHDOG=1 itself
NotifyAccess=all
User=clara
Group=clara
Environment=CLARA_ENV_FILE=/etc/clara/clara.env
Environment=CLARA_RELEASES_DIR=/opt/clara/releases
StateDirectory=clara
StateDirectoryMode=0700
# the key that opens the secrets store: never in the data folder. Make it with
#   sudo -u clara /opt/clara/current/.venv/bin/clara secrets new-key | sudo systemd-creds encrypt --name=clara-secret-key - /etc/clara/secret-key.cred
LoadCredentialEncrypted=clara-secret-key:/etc/clara/secret-key.cred
ExecStart=/opt/clara/current/.venv/bin/clara-launcher
Restart=on-failure
RestartSec=5
# above the drain limit (CLARA_DRAIN_SECONDS, 120 s): the server gets to finish what runs
TimeoutStopSec=180
KillMode=mixed
WatchdogSec=180
# Hardening that rootless Podman allows. NoNewPrivileges is not set: rootless Podman needs the setuid
# newuidmap/newgidmap helpers. Scripts get no-new-privileges inside their own containers.
# Three usual options are left out because they broke Podman on a real machine (a reboot, then an update):
#   ProtectHome=true      hides /run/user, where rootless Podman keeps its runtime, so images could not be pulled
#                         (InaccessiblePaths below closes /home and /root all the same);
#   ProtectKernelLogs=true  over-mounts /proc/kmsg in the unit's mount namespace; Podman's shared pause process keeps the
#                         namespace of whoever started it first (this unit, at boot), and every container then failed with
#                         "mount 'proc': Operation not permitted";
#   PrivateTmp=true       gives each start of the unit its own /tmp and /var/tmp; the pause process keeps the deleted ones
#                         of the previous start, so `podman pull` failed after any restart (an update, a watchdog kill).
ProtectSystem=full
InaccessiblePaths=/home /root
ProtectKernelModules=true
ProtectControlGroups=false
RestrictRealtime=true
LockPersonality=true
ReadWritePaths=/var/lib/clara /var/lib/clara-home /opt/clara
UMask=0077

[Install]
WantedBy=multi-user.target
