# /etc/clara/clara.env: Clara's settings. NON-SECRET values only: keys and tokens go in the encrypted store
# (sudo -u clara clara secrets set <name>), the store's key in a systemd credential. Mode 0600, owned by clara:
#   sudo install -m 600 -o clara -g clara deploy/clara.env.example /etc/clara/clara.env
# Every setting is listed in FEATURES.md (section "Settings"). Unset values use the defaults shown.

# --- core ---------------------------------------------------------------------------------------------------
# CLARA_DATA_DIR=/var/lib/clara             (systemd's StateDirectory gives it)
# CLARA_PORT=8765                           (Clara listens on 127.0.0.1 only; tailscale serve publishes it)
CLARA_TIMEZONE=Europe/Paris
# CLARA_PERSONA_FILE=/etc/clara/persona.md  (default: the persona Clara ships with)
# CLARA_DEBUG=false                         (true: /docs and the OpenAPI file are served)

# --- models: local Ollama hosts (this machine, your PC over the tailnet) ----------------------------------------
CLARA_OLLAMA_HOSTS=local=http://127.0.0.1:11434
# CLARA_OLLAMA_HOSTS=local=http://127.0.0.1:11434,pc=http://my-pc.your-tailnet.ts.net:11434
# CLARA_OLLAMA_CONTEXT=32768
# Hosted providers are enabled from the console (/provider enable gemini) once their key is stored.
# CLARA_DEEPSEEK_THINKING=true
# CLARA_OPENCODE_GO_HOST=https://opencode.ai/inference/go

# --- the conversation engine ---------------------------------------------------------------------------------
# CLARA_HISTORY_TURNS=20
# CLARA_MAX_TOOL_ROUNDS=20
# CLARA_CHAT_SLOTS=2
# CLARA_BACKGROUND_SLOTS=1
# CLARA_ANSWER_BUDGET=900
# CLARA_APPROVAL_WAIT=600
# CLARA_INCOGNITO_HOURS=24

# --- the workspace and scripts ---------------------------------------------------------------------------------
# CLARA_WORKSPACE=/var/lib/clara/workspace
# CLARA_WORKSPACE_MAX_SIZE=5g
# CLARA_RUN=auto                            (off: no scripts)
# CLARA_SANDBOX_IMAGE=localhost/clara-sandbox:latest   (a release pins its own image by digest)
# CLARA_RUN_TIMEOUT=120
# CLARA_RUN_MEMORY=1g
# CLARA_RUN_CPUS=2

# --- knowledge -------------------------------------------------------------------------------------------------
# CLARA_VAULT_PATH=/var/lib/clara-home/vault   (your Obsidian vault, a git clone)
# CLARA_VAULT_PUSH=true
# CLARA_DAY_DIGEST_CHARS=60000              (most a day's conversations may take when read back)
# CLARA_WAITING_REMIND_AT=09:00             (a scheduled run still waiting for your answer is reminded then)

# --- connectors ------------------------------------------------------------------------------------------------
CLARA_SEARXNG_URL=http://127.0.0.1:8888
# CLARA_PUBLIC_URL=https://my-machine.your-tailnet.ts.net   (Google's redirect; default: the Tailscale name)
# CLARA_GOOGLE_CLIENT_ID=1234-abc.apps.googleusercontent.com
# CLARA_GOOGLE_PROJECT_NUMBER=1234567890
# Gmail uses the Google client above (enable the Gmail API; scopes gmail.readonly and gmail.compose). Secret: google_client_secret
# CLARA_MICROSOFT_CLIENT_ID=00000000-0000-0000-0000-000000000000   (Outlook: an Entra app registration, platform Web; secret: microsoft_client_secret)
# CLARA_MICROSOFT_TENANT=common             (common | consumers | organizations | a tenant id or domain)
# CLARA_MAIL_POLL_SECONDS=120               (new-mail notifications, once `mail_notify` is on; 0: never; 30 at least)

# --- Discord: the bot of your private server (docs/OPERATIONS.md) ---------------------------------------------
# CLARA_DISCORD_AUTOSTART=true              (the server starts the bot with itself; not with clara-discord.service)
# CLARA_DISCORD_USER_ID=123456789012345678  (the only Discord user answered)
# CLARA_DISCORD_CHANNEL_GENERAL=...         (ids of your four text channels: chat, notifications, approvals, alerts)
# CLARA_DISCORD_CHANNEL_NOTIFICATION=...
# CLARA_DISCORD_CHANNEL_APPROVAL=...
# CLARA_DISCORD_CHANNEL_ALERTS=...
# DISCORD_BOT_TOKEN_FILE=/etc/clara/discord-token         (files only the clara user reads, mode 600)
# CLARA_TOKEN_FILE=/etc/clara/discord-clara-token
# CLARA_DISCORD_EXPECTED=true               (with clara-discord.service: alert when the bot stops checking in)

# --- operations ------------------------------------------------------------------------------------------------
CLARA_TAILSCALE=serve
# CLARA_TAILSCALE_PORT=443
# CLARA_TRAFFIC_LOG_DAYS=7
# CLARA_BACKUP_TIME=03:30
# CLARA_RESTIC_REPOSITORY=sftp:backup@other-machine.your-tailnet.ts.net:/srv/restic/clara
# CLARA_RELEASE_REPO=<owner>/clara               (where /update lists releases)
# CLARA_RELEASE_PUBKEY=<base64 Ed25519 public key: releases must then be signed>
