# The image ws_run scripts run in. Built and pushed by the release workflow, pinned by digest in each release.
# Local build: podman build -t localhost/clara-sandbox:latest sandbox/
# The base is pinned by digest in the release workflow (--build-arg BASE=python:3.12-slim@sha256:...).
ARG BASE=docker.io/library/python:3.12-slim
FROM ${BASE}

RUN apt-get update \
 && apt-get install -y --no-install-recommends bash coreutils findutils grep sed gawk curl jq git make \
    ca-certificates sqlite3 unzip zip file \
 && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir \
    numpy pandas matplotlib requests beautifulsoup4 lxml pyyaml openpyxl python-docx pypdf pillow scipy \
    tabulate rich httpx

ENV MPLBACKEND=Agg PYTHONDONTWRITEBYTECODE=1 PIP_DISABLE_PIP_VERSION_CHECK=1
WORKDIR /workspace
